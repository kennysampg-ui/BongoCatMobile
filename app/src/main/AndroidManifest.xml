<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sobreposição sobre outros apps (o usuário concede em Configurações > Exibir sobre outros apps). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Serviço em primeiro plano que mantém o personagem ativo. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notificação persistente do serviço (Android 13+). O serviço funciona mesmo se negada. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        PROPOSITALMENTE não há android.permission.INTERNET:
        o app não consegue transmitir nada para fora do aparelho.
    -->

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BongoCat">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_overlay_character" />
        </service>

        <!--
            OPCIONAL. Só é usado se o usuário ativar manualmente em Acessibilidade.
            Recebe apenas "pulsos" de teclado físico (sem código de tecla, sem texto)
            e NÃO lê o conteúdo da tela (canRetrieveWindowContent=false).
        -->
        <service
            android:name=".KeyPulseAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
